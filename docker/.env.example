# Variáveis do docker/compose.yaml. Copie para docker/.env (ignorado pelo Git) e ajuste:
#
#   cp docker/.env.example docker/.env
#   sed -i "s|^ZENY_ENCRYPTION_KEYS=.*|ZENY_ENCRYPTION_KEYS=dev:$(openssl rand -base64 32)|" docker/.env
#   sed -i "s|^ZENY_JWT_KEYS=.*|ZENY_JWT_KEYS=dev:$(openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 | tr -d '\n')|" docker/.env
#   sed -i "s|^ZENY_ADMIN_PASSWORD=.*|ZENY_ADMIN_PASSWORD=$(openssl rand -base64 18)|" docker/.env
#   sed -i "s|^ZENY_STORAGE_ROOT_PASSWORD=.*|ZENY_STORAGE_ROOT_PASSWORD=$(openssl rand -base64 24)|" docker/.env
#   sed -i "s|^ZENY_STORAGE_SECRET_KEY=.*|ZENY_STORAGE_SECRET_KEY=$(openssl rand -base64 24)|" docker/.env
#
# Os valores preenchidos abaixo são só de desenvolvimento e não são segredos; os segredos (chaves,
# senha do admin e senhas do MinIO) ficam vazios e o compose não sobe sem eles. Num ambiente real,
# troque todos por valores fortes e guarde-os fora do repositório (ARCHITECTURE §15.1).

# Profile do servidor: `prod` (logs em JSON, sem Swagger UI) ou `local` (logs legíveis e
# Swagger UI em /swagger-ui.html).
ZENY_PROFILE=prod

# Porta HTTP do proxy no host e o endereço em que ela escuta (127.0.0.1 = só esta máquina).
# Se a 80 estiver ocupada, use outra (ex.: 8000); evite a 8080, que é a do bootRun.
ZENY_HTTP_PORT=80
ZENY_HTTP_ADDRESS=127.0.0.1

# Banco, com dois papéis (mesmos nomes e valores de desenvolvimento do profile `local`):
# - ZENY_DB_MIGRATION_*: o dono dos schemas (o POSTGRES_USER do container), usado só pelo Flyway;
# - ZENY_DB_USERNAME/ZENY_DB_PASSWORD: o papel da aplicação, criado na primeira inicialização do
#   volume pelo docker/postgres/initdb/, só com DML e sem UPDATE/DELETE na trilha de auditoria.
#   Precisa ser diferente do dono: com o dono, a aplicação não sobe.
# Num volume criado antes destes dois papéis, recrie o banco (down -v) ou crie o papel à mão (README.md).
ZENY_DB_NAME=zeny
ZENY_DB_MIGRATION_USERNAME=zeny
ZENY_DB_MIGRATION_PASSWORD=zeny
ZENY_DB_USERNAME=zeny_app
ZENY_DB_PASSWORD=zeny_app

# Cifragem de campo (ARCHITECTURE §8.3): "id:base64" com 32 bytes aleatórios, gerado na sua
# máquina (comando acima). Guarde a chave enquanto usar o mesmo volume do banco: o que ela
# cifrou só se lê com ela. Vazia, o compose não sobe.
ZENY_ENCRYPTION_KEYS=
ZENY_ENCRYPTION_ACTIVE_KEY_ID=dev

# Assinatura do access token JWT (ARCHITECTURE §8.1, RS256): "kid:base64" com uma chave privada
# RSA em PKCS#8 DER (2048 bits ou mais), gerada na sua máquina (comando acima). Para rotacionar,
# acrescente a nova à lista ("novo:…,dev:…"), aponte a ativa para ela e retire a antiga depois de
# 15 min. Vazia, o compose não sobe.
ZENY_JWT_KEYS=
ZENY_JWT_ACTIVE_KEY_ID=dev

# Administrador inicial, criado só no primeiro boot (banco sem usuários) e obrigado a trocar a
# senha no primeiro login. A senha precisa de 12 a 128 caracteres; gere-a (comando acima) e
# apague-a daqui depois do primeiro login. Sem usuários e sem ela, a aplicação não sobe.
ZENY_ADMIN_LOGIN=admin
ZENY_ADMIN_PASSWORD=

# Armazenamento de anexos (MinIO, módulo files):
# - ZENY_STORAGE_ROOT_*: o root do MinIO, usado só pelo storage e pelo storage-init (senha com 8
#   caracteres ou mais, gerada na sua máquina: comando acima). Num volume criado antes da E08 do M1,
#   use aqui o usuário e a senha que eram ZENY_STORAGE_ACCESS_KEY/ZENY_STORAGE_SECRET_KEY.
# - ZENY_STORAGE_ACCESS_KEY/ZENY_STORAGE_SECRET_KEY: o usuário de serviço da api, criado pelo
#   storage-init com política só do bucket (senha com 8 caracteres ou mais, gerada na sua máquina:
#   comando acima). Precisa ser diferente do root: com o root, o storage-init falha. Quem conhece
#   essa senha lê o bucket inteiro, então ela nunca pode ser um valor conhecido.
# - ZENY_STORAGE_BUCKET: não pode ser "api" nem "actuator" (o proxy confundiria com a aplicação).
# Senhas vazias: o compose não sobe.
# - ZENY_STORAGE_PUBLIC_ENDPOINT: o endereço do proxy que os clientes usam, nas URLs assinadas dos
#   anexos comuns; com outra porta, inclua-a (ex.: http://localhost:8000).
ZENY_STORAGE_ROOT_USER=zeny
ZENY_STORAGE_ROOT_PASSWORD=
ZENY_STORAGE_BUCKET=zeny-files
ZENY_STORAGE_ACCESS_KEY=zeny-app
ZENY_STORAGE_SECRET_KEY=
ZENY_STORAGE_PUBLIC_ENDPOINT=http://localhost
