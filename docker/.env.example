# Variáveis do docker/compose.yaml. Copie para docker/.env (ignorado pelo Git) e ajuste:
#
#   cp docker/.env.example docker/.env
#   sed -i "s|^ZENY_ENCRYPTION_KEYS=.*|ZENY_ENCRYPTION_KEYS=dev:$(openssl rand -base64 32)|" docker/.env
#
# Os valores abaixo são só de desenvolvimento e não são segredos. Num ambiente real, troque
# todos por valores fortes e guarde-os fora do repositório (ARCHITECTURE §15.1).

# Profile do servidor: `prod` (logs em JSON, sem Swagger UI) ou `local` (logs legíveis e
# Swagger UI em /swagger-ui.html).
ZENY_PROFILE=prod

# Porta HTTP do proxy no host e o endereço em que ela escuta (127.0.0.1 = só esta máquina).
# Se a 80 estiver ocupada, use outra (ex.: 8000); evite a 8080, que é a do bootRun.
ZENY_HTTP_PORT=80
ZENY_HTTP_ADDRESS=127.0.0.1

# Banco (mesmos nomes e valores de desenvolvimento do profile `local`).
ZENY_DB_NAME=zeny
ZENY_DB_USERNAME=zeny
ZENY_DB_PASSWORD=zeny

# Cifragem de campo (ARCHITECTURE §8.3): "id:base64" com 32 bytes aleatórios, gerado na sua
# máquina (comando acima). Guarde a chave enquanto usar o mesmo volume do banco: o que ela
# cifrou só se lê com ela. Vazia, o compose não sobe.
ZENY_ENCRYPTION_KEYS=
ZENY_ENCRYPTION_ACTIVE_KEY_ID=dev

# Armazenamento de arquivos (MinIO). A senha precisa de 8 caracteres ou mais.
ZENY_STORAGE_ACCESS_KEY=zeny
ZENY_STORAGE_SECRET_KEY=zeny-dev-only
ZENY_STORAGE_BUCKET=zeny-files
